[Desktop Entry]
# Querencia Rechner. Desktop-ID = GApplication-ID org.querencia.Rechner, damit
# labwc und die Fensterliste Titelleistensymbol und Namen zuordnen. Erscheint
# über Categories=Utility; im Panel unter „Zubehör“.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Rechner.desktop.
Type=Application
Version=1.5
Name[de]=Taschenrechner
Name=Calculator
GenericName[de]=Taschenrechner
GenericName=Calculator
Comment[de]=Grundrechenarten, Prozent, Wurzel und Speicher
Comment=Perform arithmetic calculations
Exec=querencia-rechner
TryExec=querencia-rechner
Icon=org.querencia.Rechner
Terminal=false
Categories=GTK;Utility;Calculator;
Keywords[de]=Rechner;Taschenrechner;Rechnen;
Keywords=calculator;calc;
StartupNotify=true
StartupWMClass=org.querencia.Rechner

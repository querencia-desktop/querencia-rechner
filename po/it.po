#. TRANSLATORS: Fenstertitel wie gcalctool („Calculator“).
#: data/org.querencia.Rechner.desktop.in:10 data/org.querencia.Rechner.desktop.in:11 src/fenster.rs:196
msgid "Calculator"
msgstr "Calcolatrice"

#. TRANSLATORS: Desktop-Datei, Schlüssel Comment
#: data/org.querencia.Rechner.desktop.in:12
msgid "Perform arithmetic calculations"
msgstr "Esegue calcoli aritmetici"

#. TRANSLATORS: Desktop-Datei, Schlüssel Keywords (Liste, Einträge mit ; trennen und abschließen)
#: data/org.querencia.Rechner.desktop.in:18
msgid "calculator;calc;"
msgstr "calcolatrice;calcolo;calcolatore;"

#. TRANSLATORS: Adresse der Online-Hilfe; nur das Sprachkürzel anpassen (deutsch …/de/docs/).
#: src/dialoge.rs:92
msgid "https://querencialinux.org/en/docs/"
msgstr "https://querencialinux.org/it/docs/"

#. TRANSLATORS: Fenstertitel des Info-Dialogs; deutsch mit dem Eigennamen „Querencia Rechner“, englisch mit dem Namen aus dem Menü.
#: src/dialoge.rs:109
msgid "About Calculator"
msgstr "Informazioni su Calcolatrice"

#. TRANSLATORS: Programmname und Version im Info-Dialog; deutsch „Querencia Rechner {version}“.
#: src/dialoge.rs:120
#, no-c-format
msgid "Calculator {version}"
msgstr "Calcolatrice {version}"

#: src/dialoge.rs:128
msgid ""
"Classic calculator for Querencia Desktop\n"
"modelled on gcalctool (GNOME 2.30).\n"
"\n"
"Basic arithmetic, parentheses, percent, square root,\n"
"square, reciprocal and memory."
msgstr ""
"Calcolatrice classica per Querencia Desktop\n"
"sul modello di gcalctool (GNOME 2.30).\n"
"\n"
"Quattro operazioni, parentesi, percentuale, radice quadrata,\n"
"quadrato, reciproco e memoria."

#: src/dialoge.rs:135
msgid "Alpha – not released for everyday use."
msgstr "Alpha – non ancora pronta per l’uso quotidiano."

#: src/dialoge.rs:155
msgid "License: GPL-3.0-or-later"
msgstr "Licenza: GPL-3.0-or-later"

#: src/dialoge.rs:164
msgid "_Close"
msgstr "_Chiudi"


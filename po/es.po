#: src/dialoge.rs:92
msgid "https://querencialinux.org/en/docs/"
msgstr "https://querencialinux.org/es/docs/"

#. TRANSLATORS: Fenstertitel des Info-Dialogs; deutsch mit dem Eigennamen „Querencia Rechner“, englisch mit dem Namen aus dem Menü.
#: src/dialoge.rs:109
msgid "About Calculator"
msgstr "Acerca de Calculadora"

#. TRANSLATORS: Programmname und Version im Info-Dialog; deutsch „Querencia Rechner {version}“.
#: src/dialoge.rs:120
#, no-c-format
msgid "Calculator {version}"
msgstr "Calculadora {version}"

#: src/dialoge.rs:128
msgid ""
"Classic calculator for Querencia Desktop\n"
"modelled on gcalctool (GNOME 2.30).\n"
"\n"
"Basic arithmetic, parentheses, percent, square root,\n"
"square, reciprocal and memory."
msgstr ""
"Calculadora clásica para Querencia Desktop\n"
"inspirada en gcalctool (GNOME 2.30).\n"
"\n"
"Operaciones básicas, paréntesis, porcentaje, raíz cuadrada,\n"
"cuadrado, inverso y memoria."

#: src/dialoge.rs:135
msgid "Alpha – not released for everyday use."
msgstr "Alfa – aún no apta para el uso diario."

#: src/dialoge.rs:155
msgid "License: GPL-3.0-or-later"
msgstr "Licencia: GPL-3.0-or-later"

#: src/dialoge.rs:164
msgid "_Close"
msgstr "_Cerrar"


msgstr "https://querencialinux.org/fr/docs/"

#. TRANSLATORS: Fenstertitel des Info-Dialogs; deutsch mit dem Eigennamen „Querencia Rechner“, englisch mit dem Namen aus dem Menü.
#: src/dialoge.rs:109
msgid "About Calculator"
msgstr "À propos de Calculatrice"

#. TRANSLATORS: Programmname und Version im Info-Dialog; deutsch „Querencia Rechner {version}“.
#: src/dialoge.rs:120
#, no-c-format
msgid "Calculator {version}"
msgstr "Calculatrice {version}"

#: src/dialoge.rs:128
msgid ""
"Classic calculator for Querencia Desktop\n"
"modelled on gcalctool (GNOME 2.30).\n"
"\n"
"Basic arithmetic, parentheses, percent, square root,\n"
"square, reciprocal and memory."
msgstr ""
"Calculatrice classique pour Querencia Desktop\n"
"inspirée de gcalctool (GNOME 2.30).\n"
"\n"
"Opérations de base, parenthèses, pourcentage, racine carrée,\n"
"carré, inverse et mémoire."

#: src/dialoge.rs:135
msgid "Alpha – not released for everyday use."
msgstr "Alpha – pas encore prête pour un usage quotidien."

#: src/dialoge.rs:155
msgid "License: GPL-3.0-or-later"
msgstr "Licence : GPL-3.0-or-later"

#: src/dialoge.rs:164

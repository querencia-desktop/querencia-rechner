#. TRANSLATORS: Fenstertitel wie gcalctool („Calculator“).
#: data/org.querencia.Rechner.desktop.in:10 data/org.querencia.Rechner.desktop.in:11 src/fenster.rs:169
msgid "Calculator"
msgstr "Taschenrechner"

#. TRANSLATORS: Desktop-Datei, Schlüssel Comment
#: data/org.querencia.Rechner.desktop.in:12
msgid "Perform arithmetic calculations"
msgstr "Grundrechenarten, Prozent, Wurzel und Speicher"

#. TRANSLATORS: Desktop-Datei, Schlüssel Keywords (Liste, Einträge mit ; trennen und abschließen)
#: data/org.querencia.Rechner.desktop.in:18
msgid "calculator;calc;"
msgstr "Rechner;Taschenrechner;Rechnen;"

#. TRANSLATORS: Fenstertitel des Info-Dialogs; {name} ist „Querencia Rechner“.
#: src/dialoge.rs:87
#, no-c-format
msgid "About {name}"
msgstr "Info zu {name}"

#: src/dialoge.rs:100
msgid ""
"Classic calculator for Querencia Desktop\n"
"modelled on gcalctool (GNOME 2.30).\n"
"\n"
"Basic arithmetic, parentheses, percent, square root,\n"
"square, reciprocal and memory."
msgstr ""
"Klassischer Taschenrechner für Querencia Desktop\n"
"nach dem Vorbild von gcalctool (GNOME 2.30).\n"
"\n"
"Grundrechenarten, Klammern, Prozent, Wurzel,\n"
"Quadrat, Kehrwert und Speicher."

#: src/dialoge.rs:114
msgid "License: GNU GPL, version 3 or later"
msgstr "Lizenz: GNU GPL, Version 3 oder neuer"

#: src/dialoge.rs:120
msgid "_Close"
msgstr "_Schließen"

